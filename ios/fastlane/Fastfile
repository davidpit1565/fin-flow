default_platform(:ios)

platform :ios do
  desc "Bump the build number, build, and upload to TestFlight"
  lane :beta do
    increment_build_number(xcodeproj: "App.xcodeproj")
    build_app(
      project: "App.xcodeproj",
      scheme: "App",
      export_method: "app-store"
    )
    upload_to_testflight(skip_waiting_for_build_processing: true)
  end

  desc "Build and submit to App Store review"
  lane :release do
    increment_build_number(xcodeproj: "App.xcodeproj")
    build_app(
      project: "App.xcodeproj",
      scheme: "App",
      export_method: "app-store"
    )
    upload_to_app_store(
      submit_for_review: false, # flip to true once screenshots + review notes are in App Store Connect
      automatic_release: false,
      force: true,
      skip_metadata: false,
      skip_screenshots: true    # screenshots must be added manually the first time (real device/simulator captures)
    )
  end

  desc "Push just the text metadata (description, keywords, etc.) from ./metadata"
  lane :metadata do
    upload_to_app_store(skip_binary_upload: true, skip_screenshots: true, force: true)
  end
end

# Prerequisites (all one-time, done once the Apple Developer account exists):
#   1. bundle init && bundle add fastlane   (run from ios/)
#   2. Fill in Appfile with the real Apple ID, team ID, and App Store Connect team ID.
#   3. Create the App ID + App Store Connect record for com.solfaygroup.flow
#      (either in Xcode's "Signing & Capabilities" with automatic signing, or via
#      `fastlane match` if multiple people will build/sign this app).
#   4. bundle exec fastlane beta      # first TestFlight build
#   5. bundle exec fastlane release   # final App Store submission
#
# All of the above requires a Mac with Xcode -- fastlane drives Xcode's own
# build/sign/upload tools, it does not replace the need for one.
